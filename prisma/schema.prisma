// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
}

// Owned by recommendations_svc (see 2.3 and 4.3). user_id and product_id
// reference users_svc/catalog_svc respectively; no cross-schema relation
// is declared since services never access another service's tables directly.
model Recommendation {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  score     Decimal  @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([productId])
  @@map("recommendations")
}
