// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
}

// Owned by recommendations_svc (see 2.3 and 4.3). user_id and product_id
// reference users_svc/catalog_svc respectively; no cross-schema relation
// is declared since services never access another service's tables directly.
model Recommendation {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  score     Decimal  @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([productId])
  @@map("recommendations")
}

// Order lines learned from order.created; status mirrors order.updated.
model OrderLine {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  userId      Int      @map("user_id")
  productCode String   @map("product_code")
  quantity    Int
  status      String   @default("pending")
  eventId     String   @map("event_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([orderId, productCode])
  @@index([userId, createdAt])
  @@index([productCode])
  @@map("order_lines")
}

// Consumer idempotency: one row per handled event.
model ProcessedEvent {
  id          Int      @id @default(autoincrement())
  eventId     String   @unique @map("event_id")
  pattern     String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}
